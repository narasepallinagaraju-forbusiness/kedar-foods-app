{
  "name": "kedar-foods-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "powershell -ExecutionPolicy Bypass -File scripts/require-api-url.ps1",
    "build": "next build",
    "build:frontend": "powershell -ExecutionPolicy Bypass -File scripts/build-frontend.ps1",
    "start": "next start",
    "lint": "eslint app components scripts/product-shell.js",
    "test:customer-logic": "node --test app/lib/api/catalog.test.mjs app/lib/api/fetch-timeout.test.mjs app/lib/api/safe-link.test.mjs app/lib/api/slug.test.mjs app/lib/api/whatsapp.test.mjs",
    "test:admin-logic": "node --test app/lib/admin-api/admin.test.mjs app/lib/admin-api/image-prepare.test.mjs app/lib/admin-api/csv-import.test.mjs",
    "test:routing": "node scripts/test-routing-function.mjs",
    "test:infra": "pytest infra/tests",
    "serve:export": "node scripts/spike-server.mjs",
    "deploy:frontend": "powershell -ExecutionPolicy Bypass -File scripts/deploy-frontend.ps1 -Env prod",
    "check:python": "powershell -ExecutionPolicy Bypass -File scripts/check.ps1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
